# Public browser path for the authentication API. Do not put secrets here.
VITE_API_BASE_URL=/api

# Local development only: Vite proxies /api to this backend origin.
VITE_API_PROXY_TARGET=http://localhost:8080

# Full URL of the backend's Google OAuth start endpoint. Leave empty to hide
# the "Continue with Google" button. Local example:
VITE_OAUTH2_AUTHORIZATION_URL=http://localhost:8080/oauth2/authorization/google
